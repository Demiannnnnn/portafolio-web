# Env file for Docker Compose and nginx. Copy this file to .env and fill in the values.
# .env only contains the variables that are used in compose.yaml and nginx.conf.

#For local development, you can use .env in the root of the each service (frontend, backend) to store the environment variables for that service.

#frontend configuration
frontend_port=your_port

#backend configuration
backend_port=your_port

#database configuration
db_user=/home/user/.secrets/db_user.txt
db_password=/home/user/.secrets/db_password.txt
db_name=/home/user/.secrets/db_name.txt
db_port=your_db_port


#proxy configuration
proxy_port=your_proxy_port

