DATABASE_URL=postgres://tu_usuario:tu_password_seguro@localhost:5432/portfolio_db

# IP de visitantes (ver README):
# numero de proxies de confianza delante del backend que anaden su entrada a X-Forwarded-For.
# 0 (por defecto) = ignorar X-Forwarded-For/X-Real-IP y usar la IP de la conexion TCP.
TRUSTED_PROXY_COUNT=0
# true solo si TODO el trafico llega via Cloudflare; si no, CF-Connecting-IP se puede falsificar.
TRUST_CF_CONNECTING_IP=false
